@startuml DiagramaClasses

skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

package "modelo" {

  abstract class Usuario {
    - id : Long
    - nome : String
    - login : String
    - hashSenha : String
    + autenticar(senha : String) : boolean
    + alterarSenha(senhaAtual : String, novaSenha : String) : void
    + {abstract} getPerfil() : String
    - {static} gerarHash(senha : String) : String
  }

  class Aluno {
    - matricula : String
    + matricularEm(disciplina : Disciplina) : Matricula
    + cancelarMatricula(disciplina : Disciplina) : void
    + buscarMatriculaAtiva(disciplina : Disciplina) : Optional<Matricula>
    + consultarMatriculasAtivas() : List<Matricula>
    + consultarDisciplinasMatriculadas() : List<Disciplina>
    + podeSeMatricularEm(disciplina : Disciplina) : boolean
    + totalMatriculadasPorTipo(tipo : TipoDisciplina) : int
    + estaMatriculadoEm(disciplina : Disciplina) : boolean
  }

  class Professor {
    - siape : String
    - departamento : String
    + consultarAlunosMatriculados(disciplina : Disciplina) : List<Aluno>
    + consultarDisciplinas() : List<Disciplina>
    + lecionaDisciplina(disciplina : Disciplina) : boolean
    + adicionarDisciplina(disciplina : Disciplina) : void
  }

  class Secretaria {
    - setor : String
  }

  class Curso {
    - id : Long
    - codigo : String
    - nome : String
    - creditos : int
    + adicionarDisciplina(disciplina : Disciplina) : void
    + removerDisciplina(disciplina : Disciplina) : void
    + listarDisciplinasPorTipo(tipo : TipoDisciplina) : List<Disciplina>
  }

  class Disciplina {
    + {static} MAXIMO_ALUNOS : int = 60
    + {static} MINIMO_ALUNOS : int = 3
    - id : Long
    - codigo : String
    - nome : String
    - creditos : int
    - tipo : TipoDisciplina
    - status : StatusDisciplina
    + temVagaDisponivel() : boolean
    + atingiuQuorumMinimo() : boolean
    + getTotalMatriculados() : int
    + getVagasRestantes() : int
    + adicionarMatricula(matricula : Matricula) : void
    + removerMatricula(matricula : Matricula) : void
    + listarAlunosMatriculados() : List<Aluno>
    + abrirParaMatricula() : void
    + ativar() : void
    + cancelarPorFaltaDeQuorum() : void
    + estaDisponivelParaMatricula() : boolean
  }

  class Matricula {
    - id : Long
    - dataMatricula : LocalDateTime
    - dataCancelamento : LocalDateTime
    - status : StatusMatricula
    + cancelar() : void
    + estaAtiva() : boolean
  }

  class Curriculo {
    - id : Long
    - semestre : String
    + adicionarDisciplina(disciplina : Disciplina) : void
    + removerDisciplina(disciplina : Disciplina) : void
    + listarDisciplinasComVaga() : List<Disciplina>
    + contemDisciplina(disciplina : Disciplina) : boolean
  }

  class PeriodoMatricula {
    - id : Long
    - semestre : String
    - dataInicio : LocalDate
    - dataFim : LocalDate
    - aberto : boolean
    + abrir() : void
    + encerrar() : void
    + estaAberto() : boolean
    + estaVigente(data : LocalDate) : boolean
  }

  enum TipoDisciplina {
    OBRIGATORIA
    OPTATIVA
    - limitePorAluno : int
    + getLimitePorAluno() : int
  }

  enum StatusDisciplina {
    PLANEJADA
    ABERTA
    CONFIRMADA
    CANCELADA
  }

  enum StatusMatricula {
    ATIVA
    CANCELADA
  }
}

package "servico" {

  class ServicoAutenticacao {
    - usuarioLogado : Usuario
    + autenticar(login : String, senha : String) : Usuario
    + encerrarSessao(usuario : Usuario) : void
    + alterarSenha(usuario : Usuario, senhaAtual : String, novaSenha : String) : void
    + getUsuarioLogado() : Optional<Usuario>
  }

  class ServicoMatricula {
    + consultarDisciplinasOfertadas(aluno : Aluno) : List<Disciplina>
    + matricular(aluno : Aluno, disciplina : Disciplina) : Matricula
    + cancelarMatricula(aluno : Aluno, disciplina : Disciplina) : void
    + consultarMatriculas(aluno : Aluno) : List<Matricula>
    - validarPeriodoAberto() : PeriodoMatricula
    - validarOferta(aluno : Aluno, disciplina : Disciplina, periodo : PeriodoMatricula) : void
    - validarDisponibilidadeDeVagas(disciplina : Disciplina) : void
    - validarLimiteDeDisciplinas(aluno : Aluno, disciplina : Disciplina) : void
  }

  class ServicoSecretaria {
    + cadastrarCurso(codigo : String, nome : String, creditos : int) : Curso
    + cadastrarDisciplina(codigo : String, nome : String, creditos : int, tipo : TipoDisciplina, curso : Curso, professor : Professor) : Disciplina
    + cadastrarProfessor(nome : String, login : String, senha : String, siape : String, departamento : String) : Professor
    + cadastrarAluno(nome : String, login : String, senha : String, matricula : String, curso : Curso) : Aluno
    + gerarCurriculo(curso : Curso, semestre : String, disciplinas : List<Disciplina>) : Curriculo
    + abrirPeriodoMatriculas(semestre : String, inicio : LocalDate, fim : LocalDate) : PeriodoMatricula
    + encerrarPeriodoMatriculas(semestre : String) : List<Disciplina>
    + verificarQuoruns(semestre : String) : List<Disciplina>
  }

  class ServicoProfessor {
    + consultarDisciplinas(professor : Professor) : List<Disciplina>
    + consultarAlunosMatriculados(professor : Professor, disciplina : Disciplina) : List<Aluno>
  }
}

package "repositorio" {

  interface "Repositorio<T, ID>" as Repositorio {
    + salvar(entidade : T) : T
    + buscarPorId(id : ID) : Optional<T>
    + buscarTodos() : List<T>
    + remover(id : ID) : void
  }

  interface RepositorioUsuario {
    + buscarPorLogin(login : String) : Optional<Usuario>
    + buscarPorPerfil(perfil : Class<U>) : List<U>
  }

  interface RepositorioCurso {
    + buscarPorCodigo(codigo : String) : Optional<Curso>
  }

  interface RepositorioDisciplina {
    + buscarPorCodigo(codigo : String) : Optional<Disciplina>
    + buscarPorProfessor(professor : Professor) : List<Disciplina>
    + buscarPorCurso(curso : Curso) : List<Disciplina>
  }

  interface RepositorioMatricula {
    + buscarPorAluno(aluno : Aluno) : List<Matricula>
    + buscarPorDisciplina(disciplina : Disciplina) : List<Matricula>
    + buscarPorAlunoEDisciplina(aluno : Aluno, disciplina : Disciplina) : Optional<Matricula>
  }

  interface RepositorioCurriculo {
    + buscarPorSemestre(semestre : String) : List<Curriculo>
    + buscarPorCursoESemestre(curso : Curso, semestre : String) : Optional<Curriculo>
  }

  interface RepositorioPeriodoMatricula {
    + buscarPorSemestre(semestre : String) : Optional<PeriodoMatricula>
    + buscarPeriodoAberto() : Optional<PeriodoMatricula>
  }
}

package "integracao" {

  interface SistemaCobranca {
    + notificarMatricula(matricula : Matricula) : void
    + notificarCancelamento(matricula : Matricula) : void
  }

  class SistemaCobrancaAdapter {
    - arquivoRemessa : Path
    + notificarMatricula(matricula : Matricula) : void
    + notificarCancelamento(matricula : Matricula) : void
  }
}

package "excecao" {

  class RuntimeException
  class MatriculaException
  class AutenticacaoException
  class PeriodoFechadoException
  class SemVagaDisponivelException
  class LimiteDisciplinasExcedidoException
  class MatriculaDuplicadaException
  class DisciplinaIndisponivelException
  class EntidadeNaoEncontradaException
  class CadastroInvalidoException
}

' ---------- Herança e realização ----------
Usuario <|-- Aluno
Usuario <|-- Professor
Usuario <|-- Secretaria

RuntimeException <|-- MatriculaException
MatriculaException <|-- AutenticacaoException
MatriculaException <|-- PeriodoFechadoException
MatriculaException <|-- SemVagaDisponivelException
MatriculaException <|-- LimiteDisciplinasExcedidoException
MatriculaException <|-- MatriculaDuplicadaException
MatriculaException <|-- DisciplinaIndisponivelException
MatriculaException <|-- EntidadeNaoEncontradaException
MatriculaException <|-- CadastroInvalidoException

SistemaCobranca <|.. SistemaCobrancaAdapter

Repositorio <|-- RepositorioUsuario
Repositorio <|-- RepositorioCurso
Repositorio <|-- RepositorioDisciplina
Repositorio <|-- RepositorioMatricula
Repositorio <|-- RepositorioCurriculo
Repositorio <|-- RepositorioPeriodoMatricula


' ---------- Associações do domínio ----------
Aluno "1" -- "*" Matricula : realiza >
Disciplina "1" -- "*" Matricula : possui >
Aluno "*" --> "1" Curso : está vinculado a >
Curso "1" o-- "*" Disciplina : oferece >
Professor "1" -- "*" Disciplina : leciona >
Curriculo "*" o-- "1..*" Disciplina : compõe >
Curso "1" -- "*" Curriculo : tem >
Disciplina --> TipoDisciplina
Disciplina --> StatusDisciplina
Matricula --> StatusMatricula

note right of Matricula
  Classe associativa entre Aluno e Disciplina.
  Canceladas permanecem como histórico:
  por aluno, no máximo 4 obrigatórias e
  2 optativas ATIVAS; por disciplina,
  no máximo 60 ATIVAS (mínimo de 3 para
  ser confirmada no encerramento).
end note

' ---------- Dependências dos serviços ----------
ServicoAutenticacao ..> RepositorioUsuario
ServicoMatricula ..> RepositorioMatricula
ServicoMatricula ..> RepositorioCurriculo
ServicoMatricula ..> RepositorioPeriodoMatricula
ServicoMatricula ..> SistemaCobranca
ServicoSecretaria ..> RepositorioCurso
ServicoSecretaria ..> RepositorioDisciplina
ServicoSecretaria ..> RepositorioUsuario
ServicoSecretaria ..> RepositorioCurriculo
ServicoSecretaria ..> RepositorioPeriodoMatricula
ServicoSecretaria ..> RepositorioMatricula
ServicoSecretaria ..> SistemaCobranca
ServicoProfessor ..> RepositorioDisciplina
ServicoProfessor ..> RepositorioMatricula

@enduml
